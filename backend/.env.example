# Database
DB_USER=prediccion_user
DB_PASSWORD=change_me_in_production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prediccion_deportiva

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Flask
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True

# API
API_HOST=0.0.0.0
API_PORT=5000

# Scraping
SCRAPER_USER_AGENT_ROTATE=True
SCRAPER_DELAY_MIN=1.0
SCRAPER_DELAY_MAX=3.0
SCRAPER_PROXY_ENABLED=False
SCRAPER_PROXY_LIST=

# ML
ML_MODELS_DIR=./data/models
ML_FEATURES_CACHE_DIR=./data/cache
ML_RANDOM_SEED=42
ML_TRAIN_TEST_SPLIT=0.8
ML_CV_FOLDS=5

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log

# External APIs
FOOTBALL_DATA_API_KEY=
WEATHER_API_KEY=
